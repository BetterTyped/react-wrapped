{
  "name": "@react-wrapped/core",
  "version": "0.0.1",
  "description": "The stage, scenes, motion kit and transitions behind a Wrapped: a year in review played as a video, in React.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BetterTyped/react-wrapped.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "format": "pnpm --dir ../.. exec oxfmt --write packages/core",
    "typecheck": "pnpm --dir ../.. exec tsgo -p packages/core/tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint packages/core"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.11.0",
    "mediabunny": "1.55.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "gsap": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0"
  }
}
