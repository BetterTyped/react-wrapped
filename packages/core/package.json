{
  "name": "@react-wrapped/core",
  "version": "1.0.0",
  "description": "The stage, the motion kit, palettes, formats and transitions behind a Wrapped: a year in review played as a video, in React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "react",
    "wrapped",
    "year in review",
    "gsap",
    "animation",
    "charts",
    "video",
    "recap"
  ],
  "homepage": "https://bettertyped.github.io/react-wrapped/",
  "bugs": {
    "url": "https://github.com/BetterTyped/react-wrapped/issues"
  },
  "author": "Maciej Pyrc (https://github.com/prc5)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/react-wrapped.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "format": "pnpm --dir ../.. exec oxfmt --write packages/core",
    "typecheck": "pnpm --dir ../.. exec tsgo -p packages/core/tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint packages/core"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "gsap": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
