{
  "name": "@react-wrapped/charts",
  "version": "0.0.1",
  "description": "Twenty-one animated charts for year in review videos in React, each with its own GSAP entrance.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "wrapped",
    "year in review",
    "gsap",
    "animation",
    "charts",
    "video",
    "recap"
  ],
  "homepage": "https://bettertyped.github.io/react-wrapped/",
  "bugs": {
    "url": "https://github.com/BetterTyped/react-wrapped/issues"
  },
  "author": "Maciej Pyrc (https://github.com/prc5)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/react-wrapped.git",
    "directory": "packages/charts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "format": "pnpm --dir ../.. exec oxfmt --write packages/charts",
    "typecheck": "pnpm --dir ../.. exec tsgo -p packages/charts/tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint packages/charts"
  },
  "peerDependencies": {
    "@react-wrapped/core": "workspace:*",
    "gsap": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@react-wrapped/core": "workspace:*"
  }
}
